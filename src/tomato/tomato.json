{
  "id": "tomato",
  "name": "Tomato",
  "description": "Anime streaming provider for Tomato. Requires a manual Bearer token from a logged-in Tomato account (login uses a captcha that cannot be automated).",
  "manifestURI": "https://raw.githubusercontent.com/Jhoorodre/seanime-provider/refs/heads/master/src/tomato/tomato.json",
  "version": "0.0.1",
  "author": "Jhoorodr",
  "type": "onlinestream-provider",
  "language": "typescript",
  "lang": "pt-BR",
  "icon": "https://raw.githubusercontent.com/Jhoorodre/seanime-provider/master/icon/tomato.png",
  "payloadURI": "https://raw.githubusercontent.com/Jhoorodre/seanime-provider/refs/heads/master/src/tomato/tomato.ts",
  "isDevelopment": true,
  "userConfig": {
    "requiresConfig": true,
    "version": 1,
    "fields": [
      {
        "name": "token",
        "label": "Token de autenticação (Bearer)",
        "type": "text",
        "default": ""
      }
    ]
  }
}
